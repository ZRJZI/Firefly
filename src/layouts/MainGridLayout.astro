---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import SidebarColumn from "@/components/layout/SidebarColumn.astro";
import WallpaperSection from "@/components/layout/WallpaperSection.astro";
import { live2dWidgetConfig, sidebarLayoutConfig, siteConfig } from "@/config";
import { getBannerVisibilityState } from "@/utils/banner-visibility-utils";
import { getBackgroundImages, isHomePage } from "@/utils/layout-utils";
import { getEffectiveSidebarState } from "@/utils/sidebar-effective-utils";
import Layout from "./Layout.astro";

import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

const backgroundImages = getBackgroundImages();

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	postCategory,
	headings = [],
	encrypted = false,
	bannerPostMeta,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPage = !!postSlug;
const shouldRenderCategoryBar = !!siteConfig.categoryBar;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const stickyNavbar = siteConfig.navbar.stickyNavbar ?? false;

const banner = getBannerVisibilityState({
	isHomePage: isHomePageCheck,
	isPostPage,
	title,
	bannerPostMeta,
});
const sidebar = getEffectiveSidebarState({ isPostPage });

const { hasWallpaper } = banner;
const {
	hideSidebarOnPostPage,
	effectiveIsBothSidebars,
	effectiveHasLeftComponents,
	effectiveHasRightComponents,
	gridCols,
	sidebarClass,
	rightSidebarClass,
	staticBarClass,
	footerClassName,
	mobileShowSidebar,
} = sidebar;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} postCoverImage={postCoverImage} hasWallpaper={hasWallpaper}>

<slot slot="head" name="head" />
<HeaderTopRow stickyNavbar={stickyNavbar} navbarWidthFull={navbarWidthFull} />

<WallpaperSection state={banner} backgroundImages={backgroundImages} title={title} bannerPostMeta={bannerPostMeta} />

<!-- Main content -->
<div class="content-panel absolute w-full z-30 pointer-events-none">
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid"
          class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!mobileShowSidebar ? 'mobile-no-sidebar' : ''}`}
          data-sidebar-enable={sidebarLayoutConfig.enable ? "true" : "false"}
          data-grid-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"}
          data-sidebar-position={sidebarLayoutConfig.position}
          data-tablet-sidebar={sidebarLayoutConfig.tabletSidebar ?? "left"}
          data-show-both-sidebars-on-post={sidebarLayoutConfig.showBothSidebarsOnPostPage ? "true" : "false"}
        >

            <SidebarColumn
                side="left"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                effectiveIsBothSidebars={effectiveIsBothSidebars}
                effectiveHasLeftComponents={effectiveHasLeftComponents}
                effectiveHasRightComponents={effectiveHasRightComponents}
                sidebarClass={sidebarClass}
                rightSidebarClass={rightSidebarClass}
                headings={headings}
                encrypted={encrypted}
            />
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div class={staticBarClass}>
                {/* 分类导航栏 - 全站渲染并显示 */}
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性 */}
                <h1 class="sr-only">{title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                </div>
            </main>
            </div>

            <SidebarColumn
                side="right"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                effectiveIsBothSidebars={effectiveIsBothSidebars}
                effectiveHasLeftComponents={effectiveHasLeftComponents}
                effectiveHasRightComponents={effectiveHasRightComponents}
                sidebarClass={sidebarClass}
                rightSidebarClass={rightSidebarClass}
                headings={headings}
                encrypted={encrypted}
            />

            {/* 移动端底部组件 - 768px及以下显示 */}
            {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                <div id="mobile-bottom-sidebar" class="col-span-1 block md:hidden mt-4">
					<SideBar side="bottom" headings={headings} encrypted={encrypted}></SideBar>
                </div>
            )}

            <div class={footerClassName}>
                <Footer></Footer>
            </div>
        </div>

        <SpineModel></SpineModel>
        {live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}
    </div>
</div>

<FloatingControls headings={headings} encrypted={encrypted} />

<!--
    触屏设备上让代码块的复制按钮默认隐藏，点一下代码块才显形。
    expressive-code 没给 <pre> 加 tabindex，点击代码区不会产生焦点，
    所以纯 CSS 的 :focus-within 拿不到这个状态，只能在这里补一个类。
    显隐规则见 src/styles/expressive-code.css 的 @media (hover: none) 段。
-->

<script client:load>
// 自动从壁纸提取主色调，同步全局主题色
(function() {
  // 可微调配置
  const CONFIG = {
    // 只提取色相，保持原主题色的饱和度，视觉更协调
    keepSaturation: true,
    // 颜色渐变过渡时长，单位秒
    transition: 0.8,
    // 取色取样大小，数值越大越精准，50足够平衡速度和效果
    sampleSize: 50
  };

  // RGB 转 HSL 标准算法
  function rgbToHsl(r, g, b) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    let h, s, l = (max + min) / 2;

    if (max === min) {
      h = s = 0;
    } else {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return {
      h: Math.round(h * 360),
      s: Math.round(s * 100),
      l: Math.round(l * 100)
    };
  }

  // 提取图片平均主色
  function getAverageColor(img) {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    const scale = CONFIG.sampleSize / img.width;
    canvas.width = CONFIG.sampleSize;
    canvas.height = img.height * scale;
    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

    const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
    let r = 0, g = 0, b = 0, count = 0;

    // 间隔取样，提升性能
    for (let i = 0; i < data.length; i += 16) {
      r += data[i];
      g += data[i + 1];
      b += data[i + 2];
      count++;
    }

    return {
      r: Math.round(r / count),
      g: Math.round(g / count),
      b: Math.round(b / count)
    };
  }

  // 获取当前壁纸的图片地址
  function getWallpaperSrc() {
    // 优先找壁纸 img 标签
    const img = document.querySelector('[class*="wallpaper"] img');
    if (img && img.src) return img.src;

    // 找不到就取 div 背景图
    const el = document.querySelector('[class*="wallpaper"]');
    if (!el) return null;
    const bg = getComputedStyle(el).backgroundImage;
    const match = bg.match(/url\(["']?([^"')]+)["']?\)/);
    return match ? match[1] : null;
  }

  // 应用主题色到全局
  function applyThemeColor(src) {
    if (!src) return;

    const img = new Image();
    // 处理跨域，支持绝大多数公共随机图库API
    img.crossOrigin = 'anonymous';
    
    img.onload = function() {
      try {
        const rgb = getAverageColor(img);
        const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
        const root = document.documentElement;

        // 只修改色相变量，全站主题色自动同步
        root.style.setProperty('--hue', hsl.h);
        
        // 关闭保持饱和度时，同步壁纸本身的饱和度
        if (!CONFIG.keepSaturation) {
          root.style.setProperty('--saturation', hsl.s + '%');
        }

        // 添加平滑过渡
        root.style.transition = `--hue ${CONFIG.transition}s ease`;
      } catch (e) {
        // 取色失败自动回退默认主题色，不报错
        console.warn('壁纸取色失败，使用默认主题色', e);
      }
    };

    img.onerror = () => console.warn('壁纸加载失败，跳过取色');
    img.src = src;
  }

  // 页面加载完成后执行
  if (document.readyState === 'complete') {
    applyThemeColor(getWallpaperSrc());
  } else {
    window.addEventListener('load', () => applyThemeColor(getWallpaperSrc()));
  }

  // 进阶：开启壁纸切换功能时，监听壁纸变化自动重新取色
  setTimeout(() => {
    const wallpaperEl = document.querySelector('[class*="wallpaper"]');
    if (!wallpaperEl) return;
    
    new MutationObserver(() => {
      const newSrc = getWallpaperSrc();
      if (newSrc) applyThemeColor(newSrc);
    }).observe(wallpaperEl, {
      attributes: true,
      attributeFilter: ['src', 'style'],
      subtree: true
    });
  }, 1000);
})();
</script>


</Layout>

</style>
